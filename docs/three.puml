@startuml

skinparam shadowing false
skinparam defaultFontName Microsoft YaHei

skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #5599DD
    FontColor #222222

    DiamondBackgroundColor #FFCCCC
    DiamondBorderColor #FF5555

    StartColor #FFF4B8
    EndColor #FFF4B8
}

start

:用户输入问题;
:建立流式请求;
:Agent工厂获取/创建Agent;

if (配置个人模型?) then (是)
    :使用用户Agent;
else (否)
    :使用系统默认Agent;

    if (超过调用上限?) then (是)
        :终止本轮请求;
        stop
    else(否)
      :调用次数+1;
    endif
endif

:threadId关联会话状态;

:模型流式生成并推送到前端;

:Redis保存会话;

stop

@enduml