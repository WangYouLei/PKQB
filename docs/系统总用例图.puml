skinparam shadowing false
skinparam defaultFontName "SimSun"
skinparam rectangleFontName "SimSun"
skinparam ArrowColor #000000

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 1
}

