@startuml

skinparam shadowing false
skinparam defaultFontName Microsoft YaHei

skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #5599DD
    FontColor #222222
    DiamondBackgroundColor #FFCCCC
    DiamondBorderColor #FF5555
    StartColor #FFF4B8
    EndColor #FFF4B8
}

start

:提交用户名与密码;
:前端格式校验;

if (校验通过?) then (是)

    :后端校验账号密码;

    if (身份校验成功?) then (是)
        :生成JWT并下发;

        :携带Token发起请求;

        if (Token有效?) then (是)

            if (访问管理员接口?) then (是)

                if (校验角色通过?) then (是)
                    :执行业务操作;
                else (否)
                    :拒绝访问;
                    stop
                endif

            else (否)
                :执行业务操作;
            endif

            :登出并加入黑名单;

        else (否)
            :拒绝请求;
        endif

    else (否)
        :登录失败;
    endif

else (否)
    :提示格式错误;
endif

stop

@enduml