@startuml
title 智能试卷解析流程

skinparam shadowing false
skinparam defaultFontName Microsoft YaHei

skinparam activity {
    BackgroundColor #DDEEFF
    BorderColor #5599DD
    FontColor #222222
    DiamondBackgroundColor #FFCCCC
    DiamondBorderColor #FF5555
    StartColor #FFF4B8
    EndColor #FFF4B8
}

start

:上传试卷文件;
:前置校验;

if (校验通过?) then (是)

    if (AI解析?) then (是)

        if (需要视觉解析?) then (是)
            :视觉模型解析;
        else (否)
            :文本模型解析;
        endif

    else (否)
        :本地算法解析;
    endif

    :SSE返回结构化题目;
    :用户确认保存;

else (否)
    :返回错误提示;
endif

stop

@enduml